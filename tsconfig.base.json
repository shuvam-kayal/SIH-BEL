{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@bel/shared": ["shared/types/index.ts"],
      "@bel/shared/rbac": ["shared/rbac/index.ts"],
      "@bel/shared/*": ["shared/*"],
      "@bel/mock-api": ["mocks/mock-api/index.ts"],
      "@bel/mock-blockchain": ["mocks/mock-blockchain/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
