# Copy to .env for local development. Nothing secret belongs in this
# file or in .env — SYSTEM_SPEC.md assumes keys never leave the managed
# device.

PORT=4000
DATABASE_URL=postgresql://bel:bel@localhost:5432/bel
BEL_ENV=development
BEL_SESSION_TTL_SECONDS=3600

# Header-based dev sessions. MUST be false anywhere that isn't a
# developer's own machine (see THREAT_MODEL.md).
BEL_DEV_SESSIONS=true

# Frontend -> backend base URL. Unused while the frontend runs against
# mocks/mock-api; set it when Person 6 swaps in the real HTTP client.
VITE_API_BASE_URL=http://localhost:4000

# PostgreSQL is internal BEL operational state. Frontend clients must call the
# backend and must never receive DATABASE_URL or connect to PostgreSQL directly.
BEL_EMAIL_PROVIDER=console
BEL_SMTP_HOST=
BEL_SMTP_PORT=587
BEL_SMTP_USERNAME=
BEL_SMTP_PASSWORD=
BEL_EMAIL_FROM=
