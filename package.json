{
  "name": "bel-decentralized-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the BEL permissioned-blockchain asset and maintenance platform.",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "contracts",
    "mocks/mock-api",
    "mocks/mock-blockchain"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run dev --workspace=bel-backend",
    "dev:frontend": "npm run dev --workspace=bel-frontend",
    "build": "npm run build --workspace=bel-frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bootstrap:dev": "tsx scripts/bootstrap-dev.ts",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "tsx scripts/bootstrap-dev.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "test:contracts": "npm run test --workspace=bel-contracts",
    "test:consensus": "python3 -m pytest blockchain/tests -q",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5",
    "prisma": "5.14.0",
    "tsx": "4.11.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}
