{
  "name": "bel-backend",
  "version": "1.0.0",
  "description": "REST API implementing docs/API_SPEC.yaml. Depends on the BlockchainService interface only, never a concrete chain.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --pool=forks --no-file-parallelism --exclude test/workflow.e2e.test.ts",
    "test:e2e:workflow": "node ../scripts/test-e2e-workflow.mjs",
    "test:e2e:besu": "node ../scripts/test-e2e-besu.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.14.0",
    "cors": "2.8.5",
    "ethers": "6.13.4",
    "express": "4.19.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.12.12",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.11.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
