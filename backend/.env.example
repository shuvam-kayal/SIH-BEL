DATABASE_URL=postgresql://bel:bel@localhost:5432/bel
BEL_ENV=development
BEL_SESSION_TTL_SECONDS=3600
BEL_DEV_BOOTSTRAP=true
BEL_BOOTSTRAP_CREDENTIAL=dev-admin-001
BEL_BOOTSTRAP_PUBLIC_KEY=replace-with-device-generated-public-key
BEL_BOOTSTRAP_WALLET_ADDRESS=replace-with-device-generated-wallet-address

# Optional local-only attestation test seam. Never enable this in production.
# BEL_DEVICE_ATTESTATION=mock
# BEL_MOCK_APPROVED_DEVICE_IDS=BEL-TEST-DEVICE-001
# Production must explicitly set BEL_DEVICE_ATTESTATION_PROVIDER=managed and inject
# the authoritative BEL device-trust adapter; no built-in provider is assumed.
# BEL_DEVICE_ATTESTATION_PROVIDER=managed
# BEL_FRESH_AUTH_REQUIRED_ACTIONS=ASSET_TRANSFER,JOB_VERIFY

# PostgreSQL is BEL's internal mutable operational store. The frontend talks
# only to the backend; never expose DATABASE_URL to browser clients.

# Private evidence storage. The Compose value is http://ipfs:5001.
IPFS_API_URL=http://localhost:5001
EVIDENCE_MAX_FILE_SIZE_MB=25
EVIDENCE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain

# Blockchain adapter (backend/src/blockchain). Unit tests may use the default
# in-memory mock. The real application/integration path uses BEL_BLOCKCHAIN=evm
# and a deployment produced for the live customized Besu prototype.
# BEL_BLOCKCHAIN=evm
# BEL_CHAIN_RPC_URL=http://127.0.0.1:8645
# BEL_CHAIN_DEPLOYMENT=besu-prototype   # contracts/deployments/<name>.json
# BEL_EVM_RPC_URL=http://127.0.0.1:8645 # diagnostic/integration alias
# BEL_E2E_RPC_URL=http://127.0.0.1:8645 # E2E diagnostic/integration alias
# BEL_E2E_CHAIN_ID=20260920
# BEL_CHAIN_CONFIRMATIONS=1
# BEL_CHAIN_TX_TIMEOUT_MS=30000
# BEL_CHAIN_POLL_INTERVAL_MS=1000
# DEVELOPMENT/CI ONLY — comma-separated ephemeral keys for the real Besu
# prototype. The launcher generates them; never commit or reuse them. They
# are refused when BEL_ENV=production. Production device transactions use the
# managed device signing path instead.
# BEL_CHAIN_DEV_SIGNER_KEYS=
BEL_EMAIL_PROVIDER=console
BEL_SMTP_HOST=
BEL_SMTP_PORT=587
BEL_SMTP_USERNAME=
BEL_SMTP_PASSWORD=
BEL_EMAIL_FROM=
