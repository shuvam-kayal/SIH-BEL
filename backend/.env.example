DATABASE_URL=postgresql://bel:bel@localhost:5432/bel
BEL_ENV=development
BEL_SESSION_TTL_SECONDS=3600
BEL_DEV_BOOTSTRAP=true
BEL_BOOTSTRAP_CREDENTIAL=dev-admin-001
BEL_BOOTSTRAP_PUBLIC_KEY=replace-with-device-generated-public-key
BEL_BOOTSTRAP_WALLET_ADDRESS=replace-with-device-generated-wallet-address

# Optional local-only attestation test seam. Never enable this in production.
# BEL_DEVICE_ATTESTATION=mock
# BEL_MOCK_APPROVED_DEVICE_IDS=BEL-TEST-DEVICE-001
# BEL_FRESH_AUTH_REQUIRED_ACTIONS=ASSET_TRANSFER,JOB_VERIFY

# PostgreSQL is BEL's internal mutable operational store. The frontend talks
# only to the backend; never expose DATABASE_URL to browser clients.

# Blockchain adapter (Person 5, backend/src/blockchain). Default is the
# in-memory mock; set BEL_BLOCKCHAIN=evm to use the deployed registries.
# BEL_BLOCKCHAIN=evm
# BEL_CHAIN_RPC_URL=http://127.0.0.1:8545 (use http://evm-node:8545 inside Compose)
# BEL_CHAIN_DEPLOYMENT=local            # contracts/deployments/<name>.json, or a .json path
# BEL_CHAIN_CONFIRMATIONS=1
# BEL_CHAIN_TX_TIMEOUT_MS=30000
# BEL_CHAIN_POLL_INTERVAL_MS=1000
# DEVELOPMENT ONLY — lets the backend sign for these wallets on a local
# anvil chain. Refused when BEL_ENV=production; never commit real keys.
# BEL_CHAIN_DEV_SIGNER_KEYS=
