DATABASE_URL=postgresql://bel:bel@localhost:5432/bel
BEL_ENV=development
BEL_SESSION_TTL_SECONDS=3600
BEL_DEV_BOOTSTRAP=true
BEL_BOOTSTRAP_CREDENTIAL=dev-admin-001
BEL_BOOTSTRAP_PUBLIC_KEY=replace-with-device-generated-public-key
BEL_BOOTSTRAP_WALLET_ADDRESS=replace-with-device-generated-wallet-address

# Optional local-only attestation test seam. Never enable this in production.
# BEL_DEVICE_ATTESTATION=mock
# BEL_MOCK_APPROVED_DEVICE_IDS=BEL-TEST-DEVICE-001

# PostgreSQL is BEL's internal mutable operational store. The frontend talks
# only to the backend; never expose DATABASE_URL to browser clients.
